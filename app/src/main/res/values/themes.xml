<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KeyboardChanger" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.KeyboardChanger.Bridge" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/Animation_KeyboardChanger_NoOp</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Animation_KeyboardChanger_NoOp">
        <item name="android:activityOpenEnterAnimation">@anim/no_op</item>
        <item name="android:activityOpenExitAnimation">@anim/no_op</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_op</item>
        <item name="android:activityCloseExitAnimation">@anim/no_op</item>
    </style>

    <style name="Theme.KeyboardChanger.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <style name="Theme.KeyboardChanger.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>
</resources>
